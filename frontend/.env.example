# DrishtiCare Frontend Environment Variables
# ----------------------------------------------------
# VITE_API_URL: Root domain of backend API server without trailing slash.
# Leave empty or set to "/api" if serving frontend and backend behind the same Nginx reverse proxy.
# Set to full domain (e.g. "https://api.drishticare.org") if frontend and backend are hosted on separate domains.
VITE_API_URL=http://127.0.0.1:8000

# VITE_API_BASE_URL: Full path to the API v1 endpoint.
# Defaults to `${VITE_API_URL}/api`.
VITE_API_BASE_URL=http://127.0.0.1:8000/api
